{
  "layout": {
    "page-max-width": {
      "$value": "1280px",
      "$type": "dimension",
      "$description": "Maximum page width."
    },
    "prose-max-width": {
      "$value": "880px",
      "$type": "dimension",
      "$description": "Maximum prose width."
    },
    "section-gap": {
      "$value": "clamp(80px, 10vw, 120px)",
      "$type": "dimension",
      "$description": "Vertical section spacing."
    },
    "card-padding": {
      "$value": "clamp(24px, 3vw, 32px)",
      "$type": "dimension",
      "$description": "Card inner spacing."
    },
    "element-gap": {
      "$value": "8px",
      "$type": "dimension",
      "$description": "Gap between elements."
    }
  },
  "component": {
