    "radius-button-filled-top": {
      "$value": "{radius.none}",
      "$type": "dimension",
      "$description": "Filled button upper radius."
    },
    "radius-badge": {
      "$value": "{radius.none}",
      "$type": "dimension",
      "$description": "Badge radius."
    },
    "radius-nav": {
      "$value": "{radius.none}",
      "$type": "dimension",
