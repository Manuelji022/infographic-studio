{
  "font": {
    "serif": {
      "$value": [
        "Geist",
        "system-ui",
        "sans-serif"
      ],
      "$type": "fontFamily"
    },
    "sans": {
      "$value": [
        "Geist",
        "system-ui",
        "sans-serif"
      ],
      "$type": "fontFamily"
    },
    "mono": {
      "$value": [
        "Geist Mono",
        "ui-monospace",
        "SFMono-Regular",
        "Menlo",
        "monospace"
      ],
      "$type": "fontFamily"
    }
  },
  "paper-radius": {
    "xs": {
      "$value": "2px",
      "$type": "dimension"
    },
    "sm": {
      "$value": "4px",
      "$type": "dimension"
    },
    "md": {
      "$value": "6px",
      "$type": "dimension"
    },
    "lg": {
      "$value": "8px",
      "$type": "dimension"
    },
    "xl": {
      "$value": "10px",
      "$type": "dimension"
    },
    "2xl": {
      "$value": "12px",
      "$type": "dimension"
    },
    "3xl": {
      "$value": "16px",
      "$type": "dimension"
    },
    "4xl": {
      "$value": "20px",
      "$type": "dimension"
    },
    "5xl": {
      "$value": "24px",
      "$type": "dimension"
    },
    "full": {
      "$value": "9999px",
      "$type": "dimension"
    }
  },
  "typography": {
    "display": {
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "56px",
        "fontWeight": 600,
        "lineHeight": 1.0,
        "letterSpacing": "-0.01em"
      },
      "$type": "typography",
      "$extensions": {
        "ds": {
          "fluid": {
            "min": "36px"
          }
        }
      }
    },
    "heading": {
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "44px",
        "fontWeight": 600,
        "lineHeight": 1.2727272727272727,
        "letterSpacing": "-0.01em"
      },
      "$type": "typography",
      "$extensions": {
        "ds": {
          "fluid": {
            "min": "32px"
          }
        }
      }
    },
    "subheading-serif": {
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "24px",
        "fontWeight": 400,
        "lineHeight": 1.3333333333333333,
        "letterSpacing": "0"
      },
      "$type": "typography"
    },
    "subheading-sans": {
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "24px",
        "fontWeight": 600,
        "lineHeight": 1.3333333333333333,
        "letterSpacing": "0"
      },
      "$type": "typography"
